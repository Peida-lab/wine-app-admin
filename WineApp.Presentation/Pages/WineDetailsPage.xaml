<Page
    x:Class="WineApp.Presentation.Pages.WineDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WineApp.Presentation.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="30"
            Spacing="24"
            MaxWidth="1000"
            HorizontalAlignment="Left">

            <!-- Navigation -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="12">

                <Button
                    Content="Tillbaka till alla viner"
                    Click="Back_Click"/>

                <Button
                    Content="Redigera vin"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.IsWineLoaded, Mode=OneWay}"
                    Click="EditWine_Click"/>

            </StackPanel>

            <!-- Page title -->
            <TextBlock
                Text="Vininformation"
                FontSize="30"
                FontWeight="SemiBold"/>

            <!-- Loading -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="32"
                Height="32"
                HorizontalAlignment="Left"/>

            <!-- Error message -->
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="IndianRed"
                TextWrapping="Wrap"/>

            <!-- Main details -->
            <Grid ColumnSpacing="28">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Wine image -->
                <Border
                    Grid.Column="0"
                    Height="330"
                    Padding="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    VerticalAlignment="Top">

                    <controls:WineImage
                        ImageReference="{x:Bind ViewModel.ImageReference, Mode=OneWay}"/>

                </Border>

                <!-- Wine identity and details -->
                <StackPanel
                    Grid.Column="1"
                    Spacing="20">

                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="{x:Bind ViewModel.WineName, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.WineProducer, Mode=OneWay}"
                            FontSize="17"
                            Opacity="0.7"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.FineWineText, Mode=OneWay}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                    <Grid
                        ColumnSpacing="20"
                        RowSpacing="18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Wine type -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Vintyp"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.WineTypeText, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                        <!-- Vintage -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Årgång"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.WineYear, Mode=OneWay}"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                        <!-- Country -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Land"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.WineCountry, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                        <!-- Region -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Region"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.WineRegion, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                        <!-- Grape -->
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Druva"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.WineGrape, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                        <!-- Alcohol percentage -->
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Alkoholhalt"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.AlcoholPercentage, Mode=OneWay}"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                        <!-- Producer -->
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Producent"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.WineProducer, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                        <!-- Classification -->
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Klassificering"
                                Opacity="0.6"/>

                            <TextBlock
                                Text="{x:Bind ViewModel.FineWineText, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Grid>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">

                <StackPanel Spacing="22">

                    <!-- Description -->
                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Beskrivning"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.WineDescription, Mode=OneWay}"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- Food pairing -->
                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Rekommenderad mat"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.RecommendedFood, Mode=OneWay}"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- Wine ID -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Vin-ID"
                            Opacity="0.6"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.WineIdText, Mode=OneWay}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Opacity="0.7"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>
</Page>
