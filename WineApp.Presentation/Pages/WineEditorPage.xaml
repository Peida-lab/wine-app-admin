<Page
    x:Class="WineApp.Presentation.Pages.WineEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WineApp.Presentation.Controls">

    <!-- Resources -->
    <Page.Resources>
        <controls:WineTypeDisplayConverter
            x:Key="WineTypeDisplayConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="30"
            Spacing="20"
            MaxWidth="900"
            HorizontalAlignment="Left">

            <!-- Rubrik -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                    FontSize="30"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Hantera vinets information."
                    Opacity="0.7"/>

            </StackPanel>

            <!-- Grunduppgifter -->
            <TextBlock
                Text="Grunduppgifter"
                FontSize="20"
                FontWeight="SemiBold"/>

            <TextBox
                Header="Vinets namn"
                PlaceholderText="Ange vinets namn"
                Text="{x:Bind ViewModel.WineName, Mode=TwoWay}"/>

            <TextBox
                Header="Beskrivning"
                PlaceholderText="Beskriv vinet"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="100"
                Text="{x:Bind ViewModel.WineDescription, Mode=TwoWay}"/>

            <TextBox
                Header="Producent"
                PlaceholderText="Ange producent"
                Text="{x:Bind ViewModel.WineProducer, Mode=TwoWay}"/>

            <!-- Ursprung -->
            <TextBlock
                Text="Ursprung"
                FontSize="20"
                FontWeight="SemiBold"/>

            <Grid ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="Land"
                    PlaceholderText="Exempelvis Frankrike"
                    Text="{x:Bind ViewModel.WineCountry, Mode=TwoWay}"/>

                <TextBox
                    Grid.Column="1"
                    Header="Region"
                    PlaceholderText="Exempelvis Bordeaux"
                    Text="{x:Bind ViewModel.WineRegion, Mode=TwoWay}"/>

            </Grid>

            <!-- Vininformation -->
            <TextBlock
                Text="Vininformation"
                FontSize="20"
                FontWeight="SemiBold"/>

            <!-- Vintyp med svenska namn -->
            <controls:NoWheelComboBox
                Header="Vintyp"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.WineTypes}"
                SelectedItem="{x:Bind ViewModel.SelectedWineType, Mode=TwoWay}">

                <controls:NoWheelComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Converter={StaticResource WineTypeDisplayConverter}}"/>
                    </DataTemplate>
                </controls:NoWheelComboBox.ItemTemplate>

            </controls:NoWheelComboBox>

            <TextBox
                Header="Annan vintyp"
                PlaceholderText="Fyll i om vintypen är Övrigt"
                Text="{x:Bind ViewModel.CustomWineType, Mode=TwoWay}"/>

            <TextBox
                Header="Druva"
                PlaceholderText="Exempelvis Merlot"
                Text="{x:Bind ViewModel.WineGrape, Mode=TwoWay}"/>

            <Grid ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="Årgång"
                    PlaceholderText="Exempelvis 2020"
                    Text="{x:Bind ViewModel.WineYear, Mode=TwoWay}"/>

                <TextBox
                    Grid.Column="1"
                    Header="Alkoholhalt (%)"
                    PlaceholderText="Exempelvis 13,5"
                    Text="{x:Bind ViewModel.AlcoholPercentage, Mode=TwoWay}"/>

            </Grid>

            <TextBox
                Header="Rekommenderad mat"
                PlaceholderText="Vilken mat passar till vinet?"
                Text="{x:Bind ViewModel.RecommendedFood, Mode=TwoWay}"/>

            <!-- Klassificering -->
            <TextBlock
                Text="Klassificering"
                FontSize="20"
                FontWeight="SemiBold"/>

            <ToggleSwitch
                Header="Fine Wine – säljs endast på flaska"
                IsOn="{x:Bind ViewModel.IsFineWine, Mode=TwoWay}"/>

            <!-- Bild -->
            <TextBlock
                Text="Bild"
                FontSize="20"
                FontWeight="SemiBold"/>

            <StackPanel Spacing="12">

                <!-- Förhandsvisning av bild -->
                <Border
                    Width="170"
                    Height="200"
                    Padding="8"
                    HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <controls:WineImage
                        ImageReference="{x:Bind ViewModel.CurrentImageReference, Mode=OneWay}"
                        SelectedImagePath="{x:Bind ViewModel.SelectedImagePath, Mode=OneWay}"/>

                </Border>

                <!-- Välj bild -->
                <Button
                    Content="Välj bild"
                    HorizontalAlignment="Left"
                    Click="ChooseImage_Click"/>

                <!-- Bildstatus -->
                <TextBlock
                    Text="{x:Bind ViewModel.SelectedImageName, Mode=OneWay}"
                    Opacity="0.7"
                    TextWrapping="Wrap"/>

            </StackPanel>

            <!-- Spara -->
            <StackPanel Spacing="12">

                <Button
                    Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveWineCommand}"
                    MinWidth="140"/>

                <!-- Statusmeddelande -->
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>
</Page>
