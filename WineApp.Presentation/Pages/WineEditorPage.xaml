<Page
    x:Class="WineApp.Presentation.Pages.WineEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WineApp.Presentation.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="30"
            Spacing="20"
            MaxWidth="900"
            HorizontalAlignment="Left">

            <!-- Rubrik -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="Lägg till vin"
                    FontSize="30"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Registrera ett nytt vin i vinsamlingen."
                    Opacity="0.7"/>

            </StackPanel>

            <!-- Grunduppgifter -->
            <TextBlock
                Text="Grunduppgifter"
                FontSize="20"
                FontWeight="SemiBold"/>

            <TextBox
                Header="Vinets namn"
                PlaceholderText="Ange vinets namn"
                Text="{x:Bind ViewModel.WineName, Mode=TwoWay}"/>

            <TextBox
                Header="Beskrivning"
                PlaceholderText="Beskriv vinet"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="100"
                Text="{x:Bind ViewModel.WineDescription, Mode=TwoWay}"/>

            <TextBox
                Header="Producent"
                PlaceholderText="Ange producent"
                Text="{x:Bind ViewModel.WineProducer, Mode=TwoWay}"/>

            <!-- Ursprung -->
            <TextBlock
                Text="Ursprung"
                FontSize="20"
                FontWeight="SemiBold"/>

            <Grid ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="Land"
                    PlaceholderText="Exempelvis Frankrike"
                    Text="{x:Bind ViewModel.WineCountry, Mode=TwoWay}"/>

                <TextBox
                    Grid.Column="1"
                    Header="Region"
                    PlaceholderText="Exempelvis Bordeaux"
                    Text="{x:Bind ViewModel.WineRegion, Mode=TwoWay}"/>

            </Grid>

            <!-- Vininformation -->
            <TextBlock
                Text="Vininformation"
                FontSize="20"
                FontWeight="SemiBold"/>

            <!-- Vintyp utan oavsiktlig scrolländring -->
            <controls:NoWheelComboBox
                Header="Vintyp"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.WineTypes}"
                SelectedItem="{x:Bind ViewModel.SelectedWineType, Mode=TwoWay}"/>

            <TextBox
                Header="Annan vintyp"
                PlaceholderText="Fyll i om vintypen är Other"
                Text="{x:Bind ViewModel.CustomWineType, Mode=TwoWay}"/>

            <TextBox
                Header="Druva"
                PlaceholderText="Exempelvis Merlot"
                Text="{x:Bind ViewModel.WineGrape, Mode=TwoWay}"/>

            <Grid ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="Årgång"
                    PlaceholderText="Exempelvis 2020"
                    Text="{x:Bind ViewModel.WineYear, Mode=TwoWay}"/>

                <TextBox
                    Grid.Column="1"
                    Header="Alkoholhalt (%)"
                    PlaceholderText="Exempelvis 13,5"
                    Text="{x:Bind ViewModel.AlcoholPercentage, Mode=TwoWay}"/>

            </Grid>

            <TextBox
                Header="Rekommenderad mat"
                PlaceholderText="Vilken mat passar till vinet?"
                Text="{x:Bind ViewModel.RecommendedFood, Mode=TwoWay}"/>

            <!-- Klassificering -->
            <TextBlock
                Text="Klassificering"
                FontSize="20"
                FontWeight="SemiBold"/>

            <ToggleSwitch
                Header="Fine Wine – säljs endast på flaska"
                IsOn="{x:Bind ViewModel.IsFineWine, Mode=TwoWay}"/>

            <!-- Bild -->
            <TextBlock
                Text="Bild"
                FontSize="20"
                FontWeight="SemiBold"/>

            <Button
                Content="Välj bild"
                IsEnabled="False"/>

            <!-- Spara vin -->
            <StackPanel Spacing="12">

                <Button
                    Content="Spara vin"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveWineCommand}"
                    MinWidth="140"/>

                <!-- Statusmeddelande -->
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>
</Page>
