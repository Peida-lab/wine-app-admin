<Page
    x:Class="WineApp.Presentation.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WineApp.Domain.Wines.Models"
    xmlns:pages="using:WineApp.Presentation.Pages"
    xmlns:controls="using:WineApp.Presentation.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30" Spacing="24">

            <!-- Page heading -->
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Översikt"
                    FontSize="30"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Välkommen till Smak Wines"
                    FontSize="16"
                    Opacity="0.7"/>
            </StackPanel>

            <!-- Statistics -->
            <Grid
                ColumnSpacing="16"
                RowSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Total wines -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Totalt antal viner"
                            FontSize="16"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalWines, Mode=OneWay}"
                            FontSize="36"
                            FontWeight="SemiBold"/>
                    </StackPanel>

                </Border>

                <!-- Red wines -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Röda viner"
                            FontSize="16"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.RedWines, Mode=OneWay}"
                            FontSize="36"
                            FontWeight="SemiBold"/>
                    </StackPanel>

                </Border>

                <!-- White wines -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Vita viner"
                            FontSize="16"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.WhiteWines, Mode=OneWay}"
                            FontSize="36"
                            FontWeight="SemiBold"/>
                    </StackPanel>

                </Border>

                <!-- Fine wines -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Fine Wines"
                            FontSize="16"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.FineWines, Mode=OneWay}"
                            FontSize="36"
                            FontWeight="SemiBold"/>
                    </StackPanel>

                </Border>

            </Grid>

            <!-- Loading indicator -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="32"
                Height="32"
                HorizontalAlignment="Left"/>

            <!-- Error message -->
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="IndianRed"
                TextWrapping="Wrap"/>

            <!-- Recent wines -->
            <StackPanel Spacing="12">

                <TextBlock
                    Text="Senast registrerade viner"
                    FontSize="22"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="De fem senast registrerade vinerna. Klicka på ett vin för att visa all information."
                    Opacity="0.7"
                    TextWrapping="Wrap"/>

                <ListView
                    ItemsSource="{x:Bind ViewModel.RecentWines, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Wine_ItemClick">

                    <ListView.ItemTemplate>

                        <DataTemplate x:DataType="models:Wine">

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,4">

                                <Grid ColumnSpacing="16">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Wine image -->
                                    <Border
                                        Grid.Column="0"
                                        Width="78"
                                        Height="94"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        VerticalAlignment="Center">

                                        <controls:WineImage
                                            ImageReference="{x:Bind ImageReference, Mode=OneWay}"/>

                                    </Border>

                                    <!-- Name and grape -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="{x:Bind WineName.Value}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Text="{x:Bind WineGrape.Value}"
                                            FontSize="13"
                                            Opacity="0.7"/>

                                    </StackPanel>

                                    <!-- Producer -->
                                    <StackPanel
                                        Grid.Column="2"
                                        Spacing="4"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Producent"
                                            FontSize="12"
                                            Opacity="0.6"/>

                                        <TextBlock
                                            Text="{x:Bind WineProducer.Value}"
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <!-- Country -->
                                    <StackPanel
                                        Grid.Column="3"
                                        Spacing="4"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Land"
                                            FontSize="12"
                                            Opacity="0.6"/>

                                        <TextBlock
                                            Text="{x:Bind WineCountry.Value}"
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <!-- Wine type -->
                                    <StackPanel
                                        Grid.Column="4"
                                        Spacing="4"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Vintyp"
                                            FontSize="12"
                                            Opacity="0.6"/>

                                        <TextBlock
                                            Text="{x:Bind pages:WinesPage.GetWineTypeDisplay(WineType, CustomWineType), Mode=OneWay}"
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <!-- Fine Wine -->
                                    <CheckBox
                                        Grid.Column="5"
                                        Content="Fine Wine"
                                        IsChecked="{x:Bind IsFineWine, Mode=OneWay}"
                                        IsEnabled="False"
                                        VerticalAlignment="Center"/>

                                    <!-- Edit wine -->
                                    <Button
                                        Grid.Column="6"
                                        Content="Redigera"
                                        VerticalAlignment="Center"
                                        CommandParameter="{x:Bind WineId}"
                                        Click="EditWine_Click"/>

                                    <!-- Delete wine -->
                                    <Button
                                        Grid.Column="7"
                                        Content="Ta bort"
                                        Foreground="IndianRed"
                                        VerticalAlignment="Center"
                                        CommandParameter="{x:Bind WineId}"
                                        Click="DeleteWine_Click"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>
</Page>
