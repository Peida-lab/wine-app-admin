<Page
    x:Class="WineApp.Presentation.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WineApp.Domain.Wines.Models"
    xmlns:pages="using:WineApp.Presentation.Pages"
    xmlns:controls="using:WineApp.Presentation.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30" Spacing="24">

            <!-- Page heading -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="Översikt"
                    FontSize="30"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Välkommen till Smak Wines"
                    FontSize="16"
                    Opacity="0.7"/>

            </StackPanel>

            <!-- Compact dashboard statistics -->
            <Grid ColumnSpacing="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- All wines -->
                <Button
                    Grid.Column="0"
                    Click="AllWines_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    MinHeight="112"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Totalt antal viner"
                            FontSize="13"
                            Opacity="0.7"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalWines, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Visa alla →"
                            FontSize="12"
                            Opacity="0.7"/>

                    </StackPanel>

                </Button>

                <!-- Red wines -->
                <Button
                    Grid.Column="1"
                    Click="RedWines_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    MinHeight="112"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Röda viner"
                            FontSize="13"
                            Opacity="0.7"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.RedWines, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Visa röda viner →"
                            FontSize="12"
                            Opacity="0.7"/>

                    </StackPanel>

                </Button>

                <!-- White wines -->
                <Button
                    Grid.Column="2"
                    Click="WhiteWines_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    MinHeight="112"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Vita viner"
                            FontSize="13"
                            Opacity="0.7"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.WhiteWines, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Visa vita viner →"
                            FontSize="12"
                            Opacity="0.7"/>

                    </StackPanel>

                </Button>

                <!-- Fine wines -->
                <Button
                    Grid.Column="3"
                    Click="FineWines_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    MinHeight="112"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Fine Wines"
                            FontSize="13"
                            Opacity="0.7"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.FineWines, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Visa Fine Wines →"
                            FontSize="12"
                            Opacity="0.7"/>

                    </StackPanel>

                </Button>

            </Grid>

            <!-- Loading indicator -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="32"
                Height="32"
                HorizontalAlignment="Left"/>

            <!-- Error message -->
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="IndianRed"
                TextWrapping="Wrap"/>

            <!-- Recent wines -->
            <StackPanel Spacing="12">

                <TextBlock
                    Text="Senast registrerade viner"
                    FontSize="22"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="De fem senast registrerade vinerna. Klicka på ett vin för att visa all information."
                    Opacity="0.7"
                    TextWrapping="Wrap"/>

                <ListView
                    ItemsSource="{x:Bind ViewModel.RecentWines, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Wine_ItemClick">

                    <ListView.ItemTemplate>

                        <DataTemplate x:DataType="models:Wine">

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,4">

                                <!-- Image, flexible info, fixed actions -->
                                <Grid ColumnSpacing="14">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="94"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Wine image -->
                                    <Border
                                        Grid.Column="0"
                                        Width="78"
                                        Height="94"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        VerticalAlignment="Center">

                                        <controls:WineImage
                                            ImageReference="{x:Bind ImageReference, Mode=OneWay}"/>

                                    </Border>

                                    <!-- Flexible wine information -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="14"
                                        VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.9*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name and grape -->
                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="5"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="{x:Bind WineName.Value}"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{x:Bind WineGrape.Value}"
                                                FontSize="13"
                                                Opacity="0.7"
                                                TextWrapping="Wrap"/>

                                            <!-- Fine Wine label -->
                                            <Border
                                                Visibility="{x:Bind pages:WinesPage.GetFineWineVisibility(IsFineWine), Mode=OneWay}"
                                                HorizontalAlignment="Left"
                                                Background="#DBEAFE"
                                                BorderBrush="#93C5FD"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="9,4"
                                                Margin="0,3,0,0">

                                                <TextBlock
                                                    Text="Fine Wine"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#1D4ED8"/>

                                            </Border>

                                        </StackPanel>

                                        <!-- Producer -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="Producent"
                                                FontSize="12"
                                                Opacity="0.6"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{x:Bind WineProducer.Value}"
                                                FontSize="14"
                                                TextWrapping="Wrap"/>

                                        </StackPanel>

                                        <!-- Country -->
                                        <StackPanel
                                            Grid.Column="2"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="Land"
                                                FontSize="12"
                                                Opacity="0.6"/>

                                            <TextBlock
                                                Text="{x:Bind WineCountry.Value}"
                                                FontSize="14"
                                                TextWrapping="Wrap"/>

                                        </StackPanel>

                                        <!-- Wine type -->
                                        <StackPanel
                                            Grid.Column="3"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="Vintyp"
                                                FontSize="12"
                                                Opacity="0.6"/>

                                            <TextBlock
                                                Text="{x:Bind pages:WinesPage.GetWineTypeDisplay(WineType, CustomWineType), Mode=OneWay}"
                                                FontSize="14"
                                                TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Grid>

                                    <!-- Fixed right action column -->
                                    <StackPanel
                                        Grid.Column="2"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch">

                                        <Button
                                            Content="Redigera"
                                            Height="32"
                                            Padding="8,4"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            CommandParameter="{x:Bind WineId}"
                                            Click="EditWine_Click"/>

                                        <Button
                                            Content="Ta bort"
                                            Height="32"
                                            Padding="8,4"
                                            FontSize="12"
                                            Foreground="IndianRed"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            CommandParameter="{x:Bind WineId}"
                                            Click="DeleteWine_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>
</Page>
