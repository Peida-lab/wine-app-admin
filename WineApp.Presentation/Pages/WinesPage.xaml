<Page
    x:Class="WineApp.Presentation.Pages.WinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WineApp.Domain.Wines.Models"
    xmlns:pages="using:WineApp.Presentation.Pages"
    xmlns:controls="using:WineApp.Presentation.Controls">

    <Grid Padding="30" RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <StackPanel Grid.Row="0" Spacing="6">

            <TextBlock
                Text="Viner"
                FontSize="30"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Klicka på ett vin för att visa all information."
                Opacity="0.7"/>

        </StackPanel>

        <!-- Search and filters -->
        <Grid Grid.Row="1" ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Header="Sök vin"
                PlaceholderText="Sök namn, producent, druva..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                HorizontalAlignment="Stretch"/>

            <controls:NoWheelComboBox
                Grid.Column="1"
                Header="Vintyp"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.WineTypeFilters}"
                SelectedIndex="{x:Bind ViewModel.SelectedWineTypeIndex, Mode=TwoWay}"/>

            <controls:NoWheelComboBox
                Grid.Column="2"
                Header="Fine Wine"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.FineWineFilters}"
                SelectedIndex="{x:Bind ViewModel.SelectedFineWineIndex, Mode=TwoWay}"/>

            <controls:NoWheelComboBox
                Grid.Column="3"
                Header="Sortera efter"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"/>

        </Grid>

        <!-- Loading and errors -->
        <StackPanel Grid.Row="2" Spacing="8">

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="28"
                Height="28"
                HorizontalAlignment="Left"/>

            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="IndianRed"
                TextWrapping="Wrap"/>

        </StackPanel>

        <!-- Result count and reset -->
        <Grid Grid.Row="3" ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Spacing="6"
                VerticalAlignment="Center">

                <TextBlock
                    Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                    Opacity="0.7"/>

                <TextBlock
                    Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"/>

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Rensa filter"
                Command="{x:Bind ViewModel.ResetFiltersCommand}"
                VerticalAlignment="Center"/>

        </Grid>

        <!-- Wine list -->
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Wines, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="Wine_ItemClick">

            <ListView.ItemTemplate>

                <DataTemplate x:DataType="models:Wine">

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,4">

                        <!-- Three main columns:
                             image, flexible details, fixed actions -->
                        <Grid ColumnSpacing="14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="94"/>
                            </Grid.ColumnDefinitions>

                            <!-- Image -->
                            <Border
                                Grid.Column="0"
                                Width="78"
                                Height="94"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4"
                                VerticalAlignment="Center">

                                <controls:WineImage
                                    ImageReference="{x:Bind ImageReference, Mode=OneWay}"/>

                            </Border>

                            <!-- Flexible information area -->
                            <Grid
                                Grid.Column="1"
                                ColumnSpacing="14"
                                VerticalAlignment="Center">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.9*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name, grape and Fine Wine -->
                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="5"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="{x:Bind WineName.Value}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{x:Bind WineGrape.Value}"
                                        FontSize="13"
                                        Opacity="0.7"
                                        TextWrapping="Wrap"/>

                                    <Border
                                        Visibility="{x:Bind pages:WinesPage.GetFineWineVisibility(IsFineWine), Mode=OneWay}"
                                        HorizontalAlignment="Left"
                                        Background="#DBEAFE"
                                        BorderBrush="#93C5FD"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9,4"
                                        Margin="0,3,0,0">

                                        <TextBlock
                                            Text="Fine Wine"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#1D4ED8"/>

                                    </Border>

                                </StackPanel>

                                <!-- Producer -->
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="Producent"
                                        FontSize="12"
                                        Opacity="0.6"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{x:Bind WineProducer.Value}"
                                        FontSize="14"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                                <!-- Country -->
                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="6"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="Land"
                                        FontSize="12"
                                        Opacity="0.6"/>

                                    <TextBlock
                                        Text="{x:Bind WineCountry.Value}"
                                        FontSize="14"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                                <!-- Wine type -->
                                <StackPanel
                                    Grid.Column="3"
                                    Spacing="6"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="Vintyp"
                                        FontSize="12"
                                        Opacity="0.6"/>

                                    <TextBlock
                                        Text="{x:Bind pages:WinesPage.GetWineTypeDisplay(WineType, CustomWineType), Mode=OneWay}"
                                        FontSize="14"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Grid>

                            <!-- Always visible action column -->
                            <StackPanel
                                Grid.Column="2"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch">

                                <Button
                                    Content="Redigera"
                                    Height="32"
                                    Padding="8,4"
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    CommandParameter="{x:Bind WineId}"
                                    Click="EditWine_Click"/>

                                <Button
                                    Content="Ta bort"
                                    Height="32"
                                    Padding="8,4"
                                    FontSize="12"
                                    Foreground="IndianRed"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    CommandParameter="{x:Bind WineId}"
                                    Click="DeleteWine_Click"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</Page>
