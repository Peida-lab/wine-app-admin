<Page
    x:Class="WineApp.Presentation.Pages.WinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WineApp.Domain.Wines.Models"
    xmlns:pages="using:WineApp.Presentation.Pages">

    <Grid Padding="30" RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Rubrik -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock
                Text="Alla viner"
                FontSize="30"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Här hittar du alla registrerade viner."
                Opacity="0.7"/>
        </StackPanel>

        <!-- Laddning och felmeddelanden -->
        <StackPanel Grid.Row="1" Spacing="8">

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="28"
                Height="28"
                HorizontalAlignment="Left"/>

            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="IndianRed"
                TextWrapping="Wrap"/>

        </StackPanel>

        <!-- Vinlista -->
        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Wines, Mode=OneWay}"
            SelectionMode="None">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Wine">

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,4">

                        <Grid ColumnSpacing="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vinets namn -->
                            <StackPanel
                                Grid.Column="0"
                                Spacing="4">

                                <TextBlock
                                    Text="{x:Bind WineName.Value}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                                    Text="{x:Bind WineGrape.Value}"
                                    Opacity="0.7"
                                    FontSize="13"/>

                            </StackPanel>

                            <!-- Producent -->
                            <StackPanel
                                Grid.Column="1"
                                Spacing="4">

                                <TextBlock
                                    Text="Producent"
                                    FontSize="12"
                                    Opacity="0.6"/>

                                <TextBlock
                                    Text="{x:Bind WineProducer.Value}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- Land -->
                            <StackPanel
                                Grid.Column="2"
                                Spacing="4">

                                <TextBlock
                                    Text="Land"
                                    FontSize="12"
                                    Opacity="0.6"/>

                                <TextBlock
                                    Text="{x:Bind WineCountry.Value}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- Vintyp -->
                            <StackPanel
                                Grid.Column="3"
                                Spacing="4">

                                <TextBlock
                                    Text="Vintyp"
                                    FontSize="12"
                                    Opacity="0.6"/>

                                <TextBlock
                                    Text="{x:Bind pages:WinesPage.GetWineTypeDisplay(WineType, CustomWineType), Mode=OneWay}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- Fine Wine -->
                            <CheckBox
                                Grid.Column="4"
                                Content="Fine Wine"
                                IsChecked="{x:Bind IsFineWine, Mode=OneWay}"
                                IsEnabled="False"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</Page>
