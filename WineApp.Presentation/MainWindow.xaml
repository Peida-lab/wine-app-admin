<Window
    x:Class="WineApp.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Smak Wines">

    <NavigationView
        x:Name="MainNavigation"
        PaneTitle=""
        PaneDisplayMode="Left"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed">

        <NavigationView.MenuItems>

            <!-- Översikt -->
            <NavigationViewItem
                Content="Översikt"
                Icon="Home"
                Tag="Home"/>

            <!-- Alla viner -->
            <NavigationViewItem
                Content="Alla viner"
                Icon="Library"
                Tag="Wines"/>

            <!-- Lägg till vin -->
            <NavigationViewItem
                Content="Lägg till vin"
                Icon="Add"
                Tag="WineEditor"/>

        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame"/>

    </NavigationView>
</Window>